  "fixed_sql": [
    {
      "name": "practice_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"practice_items\" (\"id\" TEXT NOT NULL, \"changed_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"language\" TEXT NOT NULL, \"original_sentence\" TEXT NOT NULL, \"corrected_sentence\" TEXT NOT NULL, \"original_phrase\" TEXT NOT NULL, \"corrected_phrase\" TEXT NOT NULL, \"original_start\" INTEGER NULL, \"original_end\" INTEGER NULL, \"corrected_start\" INTEGER NULL, \"corrected_end\" INTEGER NULL, \"explanation\" TEXT NOT NULL DEFAULT '', \"english_sentence\" TEXT NOT NULL DEFAULT '', \"english_highlight_start\" INTEGER NULL, \"english_highlight_end\" INTEGER NULL, \"category\" TEXT NOT NULL CHECK(\"category\" IN ('Spelling', 'Grammar', 'Word Choice', 'Natural phrasing')), \"subcategory\" TEXT NOT NULL DEFAULT '', \"context_text\" TEXT NOT NULL DEFAULT '', \"chat_id\" TEXT NULL, \"input_mode\" TEXT NOT NULL, \"saved_correction_id\" TEXT NULL UNIQUE, \"ladder_stage\" INTEGER NOT NULL DEFAULT 0 CHECK(\"ladder_stage\" >= 0), \"locked_stage\" INTEGER NOT NULL DEFAULT 0 CHECK(\"locked_stage\" >= 0), \"retired\" INTEGER NOT NULL DEFAULT 0 CHECK (\"retired\" IN (0, 1)), PRIMARY KEY (\"id\"), CHECK (subcategory = '' OR (category = 'Grammar' AND subcategory IN ('prepositions', 'agreement', 'verb_forms_and_tenses', 'subjunctive', 'ser_and_estar', 'articles', 'pronouns', 'sentence_structure')) OR (category = 'Spelling' AND subcategory IN ('written_accents', 'letters', 'punctuation_and_capitals')) OR (category = 'Word Choice' AND subcategory IN ('false_friends', 'mixed_up_pairs'))));"
        }
      ]
    },
    {
      "name": "practice_questions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"practice_questions\" (\"id\" TEXT NOT NULL, \"changed_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"item_id\" TEXT NOT NULL REFERENCES practice_items (id) ON DELETE CASCADE, \"game\" TEXT NOT NULL, \"stage\" INTEGER NOT NULL CHECK(\"stage\" >= 0), \"body\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "practice_groups",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"practice_groups\" (\"id\" TEXT NOT NULL, \"changed_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"language\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"category\" TEXT NOT NULL DEFAULT '', \"subcategory\" TEXT NOT NULL DEFAULT '', \"is_revision\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_revision\" IN (0, 1)), \"stage\" INTEGER NOT NULL DEFAULT 1 CHECK(\"stage\" >= 0), \"retries_at_stage\" INTEGER NOT NULL DEFAULT 0 CHECK(\"retries_at_stage\" >= 0), \"last_passed_at\" INTEGER NULL, \"unlocks_at\" INTEGER NULL, \"finished\" INTEGER NOT NULL DEFAULT 0 CHECK (\"finished\" IN (0, 1)), PRIMARY KEY (\"id\"), CHECK (category IN ('', 'Spelling', 'Grammar', 'Word Choice', 'Natural phrasing')), CHECK (subcategory = '' OR (category = 'Grammar' AND subcategory IN ('prepositions', 'agreement', 'verb_forms_and_tenses', 'subjunctive', 'ser_and_estar', 'articles', 'pronouns', 'sentence_structure')) OR (category = 'Spelling' AND subcategory IN ('written_accents', 'letters', 'punctuation_and_capitals')) OR (category = 'Word Choice' AND subcategory IN ('false_friends', 'mixed_up_pairs'))));"
        }
      ]
    },
    {
      "name": "practice_group_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"practice_group_items\" (\"id\" TEXT NOT NULL, \"changed_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"group_id\" TEXT NOT NULL REFERENCES practice_groups (id) ON DELETE CASCADE, \"item_id\" TEXT NOT NULL REFERENCES practice_items (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL DEFAULT 0, \"missed_last_round\" INTEGER NOT NULL DEFAULT 0 CHECK (\"missed_last_round\" IN (0, 1)), \"failed_retries\" INTEGER NOT NULL DEFAULT 0 CHECK(\"failed_retries\" >= 0), PRIMARY KEY (\"id\"), UNIQUE (\"group_id\", \"item_id\"));"
        }
      ]
    },
    {
      "name": "practice_attempts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"practice_attempts\" (\"id\" TEXT NOT NULL, \"changed_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"item_id\" TEXT NOT NULL REFERENCES practice_items (id) ON DELETE CASCADE, \"question_id\" TEXT NULL REFERENCES practice_questions (id) ON DELETE SET NULL, \"group_id\" TEXT NULL REFERENCES practice_groups (id) ON DELETE SET NULL, \"mode\" TEXT NOT NULL, \"game\" TEXT NOT NULL, \"stage\" INTEGER NOT NULL CHECK(\"stage\" >= 0), \"answer\" TEXT NOT NULL DEFAULT '', \"correct\" INTEGER NOT NULL CHECK (\"correct\" IN (0, 1)), \"answered_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "practice_rules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"practice_rules\" (\"id\" TEXT NOT NULL, \"changed_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"language\" TEXT NOT NULL, \"rule_id\" TEXT NOT NULL, \"rule_name\" TEXT NOT NULL DEFAULT '', \"slot\" TEXT NOT NULL, \"needs\" TEXT NOT NULL DEFAULT '', \"starts\" TEXT NOT NULL DEFAULT '[]', \"fixed_answer\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"id\"), UNIQUE (\"language\", \"rule_id\", \"slot\"));"
        }
      ]
    }
  ]
